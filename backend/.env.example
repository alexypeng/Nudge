# Copy to backend/.env (git-ignored). Everything here is read by config/settings.py.

# --- Local development ---------------------------------------------------------

# Debug is off unless this is true. With debug off, DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=true

# Hosts allowed to reach the API. 10.0.2.2 is how the Android emulator reaches your PC;
# add your PC's LAN IP here to test from a physical phone on the same Wi-Fi.
DJANGO_ALLOWED_HOSTS=10.0.2.2,localhost,127.0.0.1

# SQLite file in backend/. Swap for a Postgres URL (e.g. Supabase) if you prefer:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Print emails (password reset codes) in the runserver terminal instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Optional -------------------------------------------------------------------

# Push notifications: put the Firebase service account key at backend/nudge-firebase-adminsdk.json
# (git-ignored), or paste its JSON here on one line.
# FIREBASE_CREDENTIALS={"type": "service_account", ...}

# LOG_LEVEL=INFO

# --- Production only ------------------------------------------------------------

# DJANGO_SECRET_KEY=<long random string>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-backend.example.com
# NINJA_NUM_PROXIES=1                      # proxies in front of the app, so rate limits see real client IPs
# DATABASE_SSL_REQUIRE=true                # Postgres only; default true
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=<api key>
# DEFAULT_FROM_EMAIL=Nudge <noreply@your-domain.com>
