# Copy to .env (git-ignored) and restart Metro after changes.

# Backend base URL, without a trailing slash.
#   Android emulator -> your PC:  http://10.0.2.2:8000
#   iOS simulator:                 http://localhost:8000
#   Physical phone on your Wi-Fi:  http://<your PC's LAN IP>:8000 (add it to DJANGO_ALLOWED_HOSTS)
#   Deployed backend:              https://your-backend.example.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
