{
  "expo": {
    "name": "Nudge",
    "slug": "nudge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nudge",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nudgeapp.nudge",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Nudge needs alarm access to alert you at your scheduled times.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nudgeapp.nudge"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "DMSans",
                "fontDefinitions": [
                  { "path": "./assets/fonts/dm-sans/dmsans_400regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/dm-sans/dmsans_500medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/dm-sans/dmsans_600semibold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/dm-sans/dmsans_700bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/dm-sans/dmsans_800extrabold.ttf", "weight": 800 },
                  { "path": "./assets/fonts/dm-sans/dmsans_900black.ttf", "weight": 900 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/dm-sans/dmsans_400regular.ttf",
              "./assets/fonts/dm-sans/dmsans_500medium.ttf",
              "./assets/fonts/dm-sans/dmsans_600semibold.ttf",
              "./assets/fonts/dm-sans/dmsans_700bold.ttf",
              "./assets/fonts/dm-sans/dmsans_800extrabold.ttf",
              "./assets/fonts/dm-sans/dmsans_900black.ttf"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#60a5fa"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0",
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b1120"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "alexypeng",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d85b4f5c-2cf1-46bd-b6a3-db2418dc9b51"
      }
    }
  }
}
